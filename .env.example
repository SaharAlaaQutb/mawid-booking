# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Database (local Docker Compose overrides the host to "db")
POSTGRES_DB=mawid
POSTGRES_USER=mawid
POSTGRES_PASSWORD=mawid
DATABASE_URL=postgres://mawid:mawid@localhost:5432/mawid

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# Frontend
VITE_API_PROXY_TARGET=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Auth cookie (must be true in production)
AUTH_REFRESH_COOKIE_SECURE=false

# Email (console in development, SMTP in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Mawid <no-reply@mawid.local>

# Throttling
DRF_ANON_THROTTLE=60/min
DRF_USER_THROTTLE=120/min
